+/*
+ * Keep a scrolled-back viewport anchored while full-screen output is
+ * transferred into the saved-lines buffer. Return rows evicted above it.
+ */
+static int
+PinScrollbackViewport(XtermWidget xw, int amount)
+{
+    TScreen *screen = TScreenOf(xw);
+    int top = screen->topline - amount;
+    int evicted = 0;
+
+    if (top < -screen->savedlines) {
+        evicted = -screen->savedlines - top;
+        top = -screen->savedlines;
+    }
+    screen->topline = top;
+
+    if (evicted > 0) {
+        if (ScrnHaveSelection(screen))
+            adjustHiliteOnFwdScroll(xw, evicted, True);
+        ScrollSelection(screen, -evicted, True);
+    }
+    return evicted;
+}
